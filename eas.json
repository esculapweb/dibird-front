{
  "cli": {
    "version": ">= 16.32.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "resourceClass": "medium"
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_ENV": "development",
        "EXPO_PUBLIC_BASE_URL": "http://192.168.0.102:8000",
        "EXPO_PUBLIC_MEDIA_URL": "http://192.168.0.102:8000",
        "SENTRY_ORG": "dibirdcom",
        "SENTRY_PROJECT": "react-native"
      },
      "channel": "development"
    },
    "development-simulator": {
      "extends": "development", 
      "ios": { "simulator": true, "resourceClass": "medium" }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "resourceClass": "medium"
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_ENV": "preview",
        "EXPO_PUBLIC_BASE_URL": "https://dibird.com",
        "EXPO_PUBLIC_MEDIA_URL": "https://s.dibird.com",
        "SENTRY_ORG": "dibirdcom",
        "SENTRY_PROJECT": "react-native"
      },
      "channel": "preview"
    },
    "production": {
      "autoIncrement": true,
      "distribution": "store",
      "ios": {
        "resourceClass": "medium"
      },
      "android": {
        "buildType": "app-bundle"  
      },
      "env": {
        "EXPO_PUBLIC_ENV": "production",
        "EXPO_PUBLIC_BASE_URL": "https://dibird.com",
        "EXPO_PUBLIC_MEDIA_URL": "https://s.dibird.com",
        "SENTRY_ORG": "dibirdcom",
        "SENTRY_PROJECT": "react-native"
      },
      "channel": "production"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "dibird.com@gmail.com",
        "ascAppId": "6769583353" 
      },
      "android": {
        // "serviceAccountKeyPath": "./google-service-account.json",
        "track": "closed" // internal → alpha → beta → production
      }
    }
  }
}
