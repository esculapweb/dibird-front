{
  "cli": {
    "version": ">= 16.32.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true,
        "resourceClass": "medium"
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_ENV": "development",
        "EXPO_PUBLIC_BASE_URL": "http://192.168.0.102:8000",
        "EXPO_PUBLIC_MEDIA_URL": "http://192.168.0.102:8000",
        "SENTRY_ORG": "dibirdcom",
        "SENTRY_PROJECT": "react-native"
      },
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "resourceClass": "medium"
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_ENV": "preview",
        "EXPO_PUBLIC_BASE_URL": "https://dibird.com",
        "EXPO_PUBLIC_MEDIA_URL": "https://s.dibird.com",
        "SENTRY_ORG": "dibirdcom",
        "SENTRY_PROJECT": "react-native"
      },
      "channel": "preview"
    },
    "production": {
      "autoIncrement": true,
      "ios": {
        "resourceClass": "medium"
      },
      "env": {
        "EXPO_PUBLIC_ENV": "production",
        "EXPO_PUBLIC_BASE_URL": "https://dibird.com",
        "EXPO_PUBLIC_MEDIA_URL": "https://s.dibird.com",
        "SENTRY_ORG": "dibirdcom",
        "SENTRY_PROJECT": "react-native"
      },
      "channel": "production"
    }
  },
  "submit": {
    "production": {}
  }
}
