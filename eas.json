{
  "cli": {
    "version": ">= 16.32.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "resourceClass": "medium"
      },
      "android": {
        "buildType": "apk"
      },
      "channel": "development"
    },
    "development-simulator": {
      "extends": "development",
      "ios": { "simulator": true, "resourceClass": "medium" }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "resourceClass": "medium"
      },
      "android": {
        "buildType": "apk"
      },
      "channel": "preview"
    },
    "production": {
      "autoIncrement": true,
      "distribution": "store",
      "ios": {
        "resourceClass": "medium"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "channel": "production"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "dibird.com@gmail.com",
        "ascAppId": "6769583353"
      },
      "android": {
        // "serviceAccountKeyPath": "./google-service-account.json",
        "track": "closed" // internal → alpha → beta → production
      }
    }
  }
}
